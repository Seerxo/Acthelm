#!/usr/bin/env bash
# Arm the Stage C worker (ENABLE_AUTONOMOUS_CODE_WRITE=true) only while the founder's one-task authorization
# exists, and disarm it otherwise. Run as root by stage-c-arm.timer on the Stage C host; docs/CODER_RUNTIME.md
# "Founder Start/Stop from the Desk".
#
# The decision is the app's own read-only app/stage_c_arm.py, run inside company-api against a read-only
# PostgreSQL session. It prints `ARM <task>` or `DISARM <reason>`; anything else, or any error, is DISARM.
# This script only performs the Compose action, exactly as the manual pilot did. It is idempotent: when the
# worker already matches the decision it changes nothing. Every arm/disarm logs one line to syslog/journal.
#
# Usage: stage-c-arm [--dry-run]     (--dry-run prints the decision and the worker state, changes nothing)
set -euo pipefail
export LC_ALL=C

DIR=${STAGE_C_ARM_DIR:-/opt/company-os}
OVERRIDE=${STAGE_C_ARM_OVERRIDE:-/root/stage-c-pilot.compose.yml}
OVERRIDE_JSON='{"services": {"company-worker": {"environment": {"ENABLE_AUTONOMOUS_CODE_WRITE": "true"}}}}'
DRY=0
case "${1:-}" in
  "") ;;
  --dry-run) DRY=1 ;;
  *) echo "usage: stage-c-arm [--dry-run]" >&2; exit 2 ;;
esac
cd "$DIR"

log() {  # one line per action: timestamp, action, reason code, task key. Never secrets.
  logger -t stage-c-arm -- "$(date -u +%Y-%m-%dT%H:%M:%SZ) action=$1 reason=$2 task=${3:--}"
}

# ---------------------------------------------------------------- inputs (validated, never sourced)
SHA=$(tr -d ' \n' < .pilot-source-sha 2>/dev/null || true)
IMAGES=()
for name in API WORKER REASONER EGRESS; do
  line=$(grep -E "^COMPANY_OS_IMAGE_${name}=sha256:[0-9a-f]{64}\$" pilot-images.env 2>/dev/null | tail -n 1 || true)
  if [ -n "$line" ]; then IMAGES+=("$line"); fi
done
INPUTS_OK=0
if [[ "$SHA" =~ ^[0-9a-f]{40}$ ]] && [ "${#IMAGES[@]}" -eq 4 ]; then INPUTS_OK=1; fi

# ---------------------------------------------------------------- decision (fail closed)
DECISION="DISARM bad_inputs"
if [ "$INPUTS_OK" = 1 ]; then
  out=$(docker exec -i -e PGOPTIONS='-c default_transaction_read_only=on' company-api python -I - "$SHA" \
        2>/dev/null <<'PY' || true
import sys
sys.path.insert(0, "/app")  # -I drops the working directory from sys.path; the image keeps the code in /app
from app import stage_c_arm
print(stage_c_arm.main(sys.argv[1]))
PY
)
  if [[ "$out" =~ ^ARM\ [A-Z]+-[0-9]{1,6}$ || "$out" =~ ^DISARM\ [a-z_]{1,64}$ ]]; then
    DECISION=$out
  else
    DECISION="DISARM read_error"
  fi
fi
ACTION=${DECISION%% *}
DETAIL=${DECISION#* }
TASK=-; REASON=$DETAIL
if [ "$ACTION" = ARM ]; then TASK=$DETAIL; REASON=authorized; fi

# ---------------------------------------------------------------- current worker state
ARMED=$(docker exec company-worker printenv ENABLE_AUTONOMOUS_CODE_WRITE 2>/dev/null || echo unknown)
RUNNING=$(docker inspect -f '{{.State.Running}}' company-worker 2>/dev/null || echo false)

if [ "$DRY" = 1 ]; then
  echo "decision: $DECISION"
  echo "worker:   ENABLE_AUTONOMOUS_CODE_WRITE=$ARMED running=$RUNNING"
  exit 0
fi

compose() {  # the manual pilot command; extra -f files come first
  env -u COMPOSE_FILE -u COMPOSE_PROFILES -u COMPOSE_ENV_FILES "${IMAGES[@]}" COMPANY_OS_GIT_SHA="$SHA" \
    docker compose -p company-os --env-file .env -f docker-compose.yml "$@" \
    up -d --no-deps --no-build --pull never company-worker
}

disarm() {
  if [ "$INPUTS_OK" = 1 ] && compose >/dev/null 2>&1; then
    rm -f -- "$OVERRIDE"
    log DISARM "$REASON" "$TASK"
  else
    # Cannot recreate it safely (unreadable image pins or a Compose failure): stop it. A stopped worker
    # writes nothing; the next tick with good inputs starts it again, unarmed or armed as decided.
    docker stop company-worker >/dev/null 2>&1 || true
    rm -f -- "$OVERRIDE"
    log DISARM_STOP "$REASON" "$TASK"
  fi
}

if [ "$ACTION" = ARM ]; then
  [ "$ARMED" = true ] && exit 0
  if [ "$(docker exec company-api printenv CODER_PAUSE_FENCE_ENABLED 2>/dev/null || true)" != true ]; then
    REASON=pause_fence_off
    if [ "$ARMED" != false ] && [ "$RUNNING" = true ]; then disarm; else log ARM_REFUSED "$REASON" "$TASK"; fi
    exit 1
  fi
  if [ -L "$OVERRIDE" ]; then log ARM_REFUSED override_symlink "$TASK"; exit 1; fi
  tmp=$(umask 077 && mktemp "$(dirname "$OVERRIDE")/.stage-c-pilot.XXXXXX")
  printf '%s\n' "$OVERRIDE_JSON" > "$tmp"
  chmod 600 "$tmp"
  mv -f -- "$tmp" "$OVERRIDE"
  if compose -f "$OVERRIDE" >/dev/null 2>&1; then
    log ARM "$REASON" "$TASK"
  else
    REASON=compose_failed
    disarm
    exit 1
  fi
  exit 0
fi

# DISARM. Already off (or no running worker, which writes nothing): only make sure no override is left behind.
if [ "$ARMED" = false ] || [ "$RUNNING" != true ]; then
  rm -f -- "$OVERRIDE"
  exit 0
fi
disarm
