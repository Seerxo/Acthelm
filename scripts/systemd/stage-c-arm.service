# Runs scripts/stage-c-arm once: arms the Stage C worker only while the founder's one-task authorization
# (Desk Start Pilot) exists, disarms it otherwise. Root, because it recreates the worker container.
# flock keeps a manual run and the timer from acting at the same time; a busy lock skips this tick.
[Unit]
Description=Company OS Stage C worker arm/disarm (founder authorization bound)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/stage-c-arm.lock /opt/company-os/scripts/stage-c-arm
# Docker calls are bounded inside the script; its worst case is 355 s (see scripts/stage-c-arm). The whole run gets
# more than that, so the fallback stop and its read-back always run before systemd could stop the script.
TimeoutStartSec=400
# Stopping the unit mid-arm runs one verified disarm (scripts/stage-c-arm on_interrupt). Worst case: the bounded call in
# progress (a Compose run, 60 s + 5 s kill grace) plus the disarm (Compose 65 s, read-back 15 s, fallback stop 15 s and
# read-back 15 s, three 2 s log lines) = 65 + 116 = 181 s. 240 s leaves room; systemd's default 90 s would SIGKILL it.
TimeoutStopSec=240
