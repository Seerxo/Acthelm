#!/usr/bin/env bash
# Offline rebuild of app/static from desk/ for the release gateway (docs/security/DESK_BUNDLE_RELEASE.md).
# Founder-installed as /usr/local/sbin/release-gateway-desk-build (root:root 0755) and allowed to the gateway user
# by sudoers, exactly like release-gateway-checks. The gateway calls it as `desk_build_command` with one argument: its
# own fresh directory holding only desk/ (read from git objects) and an empty app/static. It never sees the
# committed bundle. The gateway hashes what lands in app/static and compares; this script decides nothing.
#
#   release-gateway-desk-build <dir>          build: pinned node image, --network=none, npm ci --offline, npm run build
#   release-gateway-desk-build seed <dir>     founder only, a real root session (refused under sudo), needs network:
#                                             fill the npm cache from <dir>/desk's lockfile
#
# Root never writes to, mounts or reads through the caller's pathname: desk/ is read AS THE CALLER (setpriv) into a
# root-owned staging dir, the container builds in its own size-limited tmpfs with no writable host mount and emits
# app/static as a tar on stdout (capped), and the checked regular files are written back AS THE CALLER.
#
# Exit 75 (EX_TEMPFAIL) = a prerequisite of this host is missing (image pin, image, cache, setpriv): the gateway
# retries, bounded, and never treats it as a pass. Any other non-zero exit is a failed build of that commit.
set -euo pipefail
umask 022

PIN_FILE=/etc/release-gateway/desk-build-image     # one line: <image>@sha256:<64 hex>, root-owned, founder-set
STATE=/var/lib/release-gateway-desk                # root-owned
CACHE=$STATE/npm-cache                             # filled only by `seed`; mounted read-only for builds
STAGE_ROOT=$STATE/stage                            # root-owned 0700: per-build staging dirs (mktemp)
IN_CAP=$((64 << 20))                               # bytes of desk/ sources accepted from the caller
OUT_CAP=$((64 << 20))                              # bytes of app/static accepted from the build
DEADLINE=1500                                      # seconds; below the gateway's own 1800 s subprocess timeout

unavailable() { echo "release-gateway-desk-build: $*" >&2; exit 75; }
refuse() { echo "release-gateway-desk-build: $*" >&2; exit 2; }

mode=build
if [[ ${1:-} == seed ]]; then
  mode=seed; shift
  # Under sudo EUID is 0 too: the gateway's sudo grant must never reach seed (it needs network).
  [[ -z ${SUDO_UID:-}${SUDO_USER:-} ]] || refuse "seed is a founder step for a real root session, refused under sudo"
fi
[[ $# == 1 ]] || { echo "usage: $0 [seed] <dir>" >&2; exit 2; }
work=$(cd -P -- "$1" 2>/dev/null && pwd -P) || refuse "no such directory: $1"
[[ -d $work/desk && -f $work/desk/package-lock.json ]] || refuse "no desk/package-lock.json in $work"
[[ -z $(find "$work" -type l -print -quit) ]] || refuse "symlink under $work"   # fast pre-check; staging re-checks

if [[ $mode == build ]]; then
  # The gateway's own directory: named by default_desk_build, owned by the calling (gateway) user.
  [[ ${SUDO_UID:-} =~ ^[1-9][0-9]*$ && ${SUDO_GID:-$SUDO_UID} =~ ^[0-9]+$ ]] || refuse "build runs only via sudo"
  [[ $(basename "$work") == gateway-desk-* && $(stat -c %u "$work") == "$SUDO_UID" ]] \
    || refuse "refusing a directory the gateway did not create: $work"
  [[ -d $work/app/static && -z $(ls -A "$work/app/static") ]] || refuse "app/static must start empty"
fi

[[ -f $PIN_FILE && ! -L $PIN_FILE && $(stat -c %u "$PIN_FILE") == 0 ]] || unavailable "no root-owned image pin"
IMAGE=$(<"$PIN_FILE")
[[ $IMAGE =~ ^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$ ]] || unavailable "image pin is not a digest"
docker image inspect "$IMAGE" >/dev/null 2>&1 || unavailable "pinned image is not present (founder: docker pull)"

if [[ $mode == seed ]]; then
  # Founder only: the lockfile to seed from must sit in a root-owned directory, which the gateway user cannot make.
  # (npm verifies every cached package against the lockfile's integrity hash, so a cache cannot change a build.)
  [[ $EUID == 0 && $(stat -c %u "$work") == 0 && $(stat -c %u "$work/desk/package-lock.json") == 0 ]] \
    || refuse "seed is a founder step: <dir> and its lockfile must be root-owned"
  install -d -m 0755 -o root -g root "$CACHE"
  exec docker run --rm --cap-drop=ALL --security-opt=no-new-privileges --read-only --tmpfs /tmp:rw,exec,size=2g \
    -e HOME=/tmp -v "$CACHE:/cache" -v "$work/desk:/src:ro" "$IMAGE" \
    sh -euc 'cp -R /src /tmp/desk && cd /tmp/desk && npm ci --cache /cache --ignore-scripts --no-audit --no-fund'
fi

[[ -d $CACHE && ! -L $CACHE && $(stat -c %u "$CACHE") == 0 ]] || unavailable "no root-owned npm cache (founder: seed)"
command -v setpriv >/dev/null || unavailable "setpriv (util-linux) is missing"
[[ -d $STATE && ! -L $STATE && $(stat -c %u "$STATE") == 0 ]] || unavailable "no root-owned $STATE (founder: seed)"
install -d -m 0700 -o root -g root "$STAGE_ROOT"
[[ ! -L $STAGE_ROOT && $(stat -c %u:%a "$STAGE_ROOT") == 0:700 ]] || unavailable "$STAGE_ROOT is not root-owned 0700"

as_caller() { setpriv --reuid="$SUDO_UID" --regid="${SUDO_GID:-$SUDO_UID}" --clear-groups -- "$@"; }
name='' stage=''
cleanup() {
  if [[ -n $name ]]; then docker rm -f "$name" >/dev/null 2>&1 || true; fi
  if [[ -n $stage ]]; then rm -rf -- "$stage"; fi
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP
stage=$(mktemp -d "$STAGE_ROOT/b.XXXXXXXX")
name=release-gateway-desk-build-${stage##*/b.}

# A tar from untrusted hands: at most `cap` bytes, only regular files and directories, no absolute or `..` names,
# extracted by root into `dest` (a fresh root-owned dir) and re-checked on disk.
# Validated from headers alone before anything is written: the size cap and ulimit -f bound neither the member count
# nor sparse members, so the sum of sizes, the count and the member types are checked here first.
TAR_CHECK=$(cat <<'PY'
import sys, tarfile
cap, total = int(sys.argv[2]), 0
with tarfile.open(sys.argv[1], "r:") as t:
    for n, m in enumerate(t, 1):
        total += m.size
        parts = m.name.split("/")
        if (n > 20000 or total > cap or m.type not in (tarfile.REGTYPE, tarfile.AREGTYPE, tarfile.DIRTYPE)
                or m.issparse() or m.name.startswith("/") or ".." in parts):
            sys.exit(f"refused member {n}: {m.name!r}")
PY
)
untar_checked() {  # <tar> <cap> <dest>
  local tar=$1 cap=$2 dest=$3
  (( $(stat -c %s "$tar") <= cap )) || refuse "archive exceeds $cap bytes"
  python3 -I -c "$TAR_CHECK" "$tar" "$cap" || refuse "archive failed validation (types, sparse, names, size or count)"
  # (no grep -q: under pipefail an early grep exit would SIGPIPE tar and invert the check)
  [[ -z $(tar -tvf "$tar" | grep -v '^[-d]') ]] || refuse "archive holds something other than regular files and directories"
  [[ -z $(tar -tf "$tar" | grep -E '^/|(^|/)\.\.(/|$)') ]] || refuse "archive holds an absolute or .. path"
  mkdir -m 0755 "$dest"
  (ulimit -f $((cap >> 10)); tar -xf "$tar" -C "$dest" --no-same-owner --no-same-permissions)
  [[ -z $(find "$dest" ! -type f ! -type d -print -quit) && -z $(find "$dest" -type f -links +1 -print -quit) ]] \
    || refuse "staged copy holds something other than regular files and directories"
  (( $(du -sb "$dest" | cut -f1) <= cap )) || refuse "staged copy exceeds $cap bytes"
}

# In: read desk/ as the caller (whatever it swaps, it can only show us what it can read itself).
as_caller tar -C "$work" -cf - desk | head -c $((IN_CAP + 1)) >"$stage/in.tar"
untar_checked "$stage/in.tar" "$IN_CAP" "$stage/in"

# Build: no writable host mount; the only writable area is the container's size-limited tmpfs (exec: npm's
# node_modules/.bin tools run from it; `--mount type=tmpfs` would be noexec). app/static leaves
# the container as a tar on stdout (npm's output goes to stderr), capped by head.
set +e
timeout -k 15 "$DEADLINE" docker run --rm --name "$name" --network=none --read-only --cap-drop=ALL \
  --security-opt=no-new-privileges --pids-limit=1024 --memory=4g --user "$SUDO_UID:${SUDO_GID:-$SUDO_UID}" \
  --tmpfs /tmp:rw,exec,size=2g,mode=1777 -e HOME=/tmp \
  -e npm_config_update_notifier=false \
  --mount "type=bind,source=$CACHE,destination=/cache,readonly" \
  --mount "type=bind,source=$stage/in/desk,destination=/src,readonly" "$IMAGE" \
  sh -euc 'mkdir -p /tmp/w/app/static && cp -R /src /tmp/w/desk && cp -R /cache /tmp/npm-cache && cd /tmp/w/desk
           { npm ci --offline --cache /tmp/npm-cache --ignore-scripts --no-audit --no-fund && npm run build; } >&2
           tar -C /tmp/w/app/static -cf - .' \
  | head -c $((OUT_CAP + 1)) >"$stage/out.tar"
status=("${PIPESTATUS[@]}")
set -e
[[ ${status[0]} == 0 ]] || { echo "release-gateway-desk-build: build failed (exit ${status[0]})" >&2; exit 1; }
untar_checked "$stage/out.tar" "$OUT_CAP" "$stage/out"
find "$stage/out" -type f -exec chmod 0644 -- {} +   # git must see 100644 (generated_facts refuses any other mode)
find "$stage/out" -type d -exec chmod 0755 -- {} +

# Out: only the checked regular files, written as the caller into its own app/static.
tar -C "$stage/out" -cf - . | as_caller tar -C "$work/app/static" -xf - --no-same-owner --no-same-permissions
